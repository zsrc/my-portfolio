---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
import type { RichBlock } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const moreProjects = projects.filter(p => p.slug !== project.slug && !p.archived).slice(0, 3);

// Split processBlocks into pre-visual text and visual+trailing segments
type VisualBlock =
  | { type: 'image'; src: string; caption?: string; fullWidth?: boolean }
  | { type: 'side-by-side'; left: string; right: string; caption?: string }
  | { type: 'grid-2x2'; images: [string, string, string, string]; caption?: string };
const isVisual = (b: { type: string }) => b.type === 'image' || b.type === 'side-by-side' || b.type === 'grid-2x2';

const processPreImageBlocks = project.processBlocks
  ? (() => {
      const firstIdx = project.processBlocks!.findIndex(isVisual);
      return firstIdx === -1 ? project.processBlocks! : project.processBlocks!.slice(0, firstIdx);
    })()
  : null;

const processImageSegments = project.processBlocks
  ? (() => {
      const segments: { visual: VisualBlock; trailing: Exclude<RichBlock, { type: 'image' | 'side-by-side' | 'grid-2x2' }>[] }[] = [];
      const blocks = project.processBlocks!;
      for (let i = 0; i < blocks.length; i++) {
        const b = blocks[i];
        if (isVisual(b)) {
          const trailing: Exclude<RichBlock, { type: 'image' | 'side-by-side' | 'grid-2x2' }>[] = [];
          while (i + 1 < blocks.length && !isVisual(blocks[i + 1])) {
            i++;
            trailing.push(blocks[i] as Exclude<RichBlock, { type: 'image' | 'side-by-side' | 'grid-2x2' }>);
          }
          segments.push({ visual: b as VisualBlock, trailing });
        }
      }
      return segments;
    })()
  : [];

// Split overviewBlocks the same way, so visuals break out of the 2-col grid and center on the page
const overviewPreImageBlocks = project.overviewBlocks
  ? (() => {
      const firstIdx = project.overviewBlocks!.findIndex(isVisual);
      return firstIdx === -1 ? project.overviewBlocks! : project.overviewBlocks!.slice(0, firstIdx);
    })()
  : null;

const overviewImageSegments = project.overviewBlocks
  ? (() => {
      const segments: { visual: VisualBlock; trailing: Exclude<RichBlock, { type: 'image' | 'side-by-side' | 'grid-2x2' }>[] }[] = [];
      const blocks = project.overviewBlocks!;
      for (let i = 0; i < blocks.length; i++) {
        const b = blocks[i];
        if (isVisual(b)) {
          const trailing: Exclude<RichBlock, { type: 'image' | 'side-by-side' | 'grid-2x2' }>[] = [];
          while (i + 1 < blocks.length && !isVisual(blocks[i + 1])) {
            i++;
            trailing.push(blocks[i] as Exclude<RichBlock, { type: 'image' | 'side-by-side' | 'grid-2x2' }>);
          }
          segments.push({ visual: b as VisualBlock, trailing });
        }
      }
      return segments;
    })()
  : [];
---

<Layout title={`${project.title} — Zehra`}>

  <!-- Floating pill nav -->
  <nav id="case-nav" class="fixed z-50 flex justify-between items-center">
    <a href="/" class="z-logo" aria-label="Home">
      <svg viewBox="0 0 20 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 24px; height: 29px;">
        <path d="M0 23.2727V19.7727L11 5.09091H0.0454546V0H19.0455V3.5L8.04545 18.1818H19V23.2727H0Z" fill="white"/>
      </svg>
    </a>
    <ul class="flex gap-10 font-medium" style="font-size: 20px; letter-spacing: -0.5px; color: #ffffff;">
      <li><a href="/#work">Work</a></li>
      <li><a href="/#writing">Writing</a></li>
      <li><a href="/#about">About</a></li>
      <li><a href="/#contact">Contact</a></li>
    </ul>
  </nav>

  <main>

    <!-- Hero card -->
    <section style="background-color: #0a0a0a; border-radius: 24px; margin: 12px 12px 0 12px; min-height: calc(75vh - 18px); overflow: hidden; padding: 40px 48px; display: flex; flex-direction: column; justify-content: flex-end;">
      <div>
        <h1 class="font-medium" style="color: #ffffff; font-size: clamp(28px, 4vw, 52px); line-height: 1.25; max-width: 52%; letter-spacing: -2px;">
          {project.title}
        </h1>
        {project.nda && (
          <span class="nda-tag">NDA</span>
        )}
      </div>
    </section>

    <!-- Meta bar -->
    <section class="py-12 border-b border-gray-100">
      <div class="container" style={`display: grid; grid-template-columns: repeat(${project.metaItems ? project.metaItems.length : 3}, 1fr); gap: 32px;`}>
        {project.metaItems ? project.metaItems.map((item) => (
          <div>
            <p class="font-medium uppercase" style="font-size: 11px; letter-spacing: 0.08em; margin-bottom: 6px; color: rgba(0,0,0,0.4);">{item.label}</p>
            <p class="font-normal text-black" style="font-size: 20px; letter-spacing: -0.5px;">{item.value}</p>
          </div>
        )) : (
          <>
            <div>
              <p class="font-medium uppercase" style="font-size: 11px; letter-spacing: 0.08em; margin-bottom: 6px; color: rgba(0,0,0,0.4);">Year</p>
              <p class="font-normal text-black" style="font-size: 20px; letter-spacing: -0.5px;">{project.year}</p>
            </div>
            <div>
              <p class="font-medium uppercase" style="font-size: 11px; letter-spacing: 0.08em; margin-bottom: 6px; color: rgba(0,0,0,0.4);">Team</p>
              <p class="font-normal text-black" style="font-size: 20px; letter-spacing: -0.5px;">{project.team}</p>
            </div>
            <div>
              <p class="font-medium uppercase" style="font-size: 11px; letter-spacing: 0.08em; margin-bottom: 6px; color: rgba(0,0,0,0.4);">Contribution</p>
              <p class="font-normal text-black" style="font-size: 20px; letter-spacing: -0.5px;">{project.contribution}</p>
            </div>
          </>
        )}
      </div>
    </section>

    <!-- Overview -->
    <section class="section">
      <div class="container grid gap-16" style="grid-template-columns: 1fr 2fr;">
        <div>
          <div class="border-t border-gray-200 pt-4">
            <h2 class="font-medium text-black" style="font-size: 32px; letter-spacing: -1px;">{project.overviewTitle ?? 'Overview'}</h2>
          </div>
        </div>
        <div class="overview-body">
          {overviewPreImageBlocks ? overviewPreImageBlocks.map((block) => {
            if (block.type === 'eyebrow') return <p class="rich-eyebrow" set:html={block.html} />;
            if (block.type === 'h2') return <h2 class="rich-h2" set:html={block.html} />;
            if (block.type === 'h3') return <h3 class="rich-h3" set:html={block.html} />;
            if (block.type === 'callout') return (
              <div class="rich-callout">
                <p class="rich-callout-title">{block.title}</p>
                <p class="rich-callout-body" set:html={block.html} />
              </div>
            );
            return <p class="rich-p" set:html={block.html} />;
          }) : project.overview.split('\n\n').map((para) => (
            <p class="font-normal" style="font-size: 24px; letter-spacing: -0.7px; line-height: 1.5; color: rgba(0,0,0,0.659);">
              {para}
            </p>
          ))}
          {project.nda && (
            <blockquote class="nda-note">
              {project.ndaNote ?? 'The visuals and layouts included here are my own re-creations of the project\'s design work. Due to confidentiality agreements, they are not the final production screens but conceptual representations used to illustrate the process and design thinking.'}
            </blockquote>
          )}
        </div>
      </div>
    </section>

    <!-- Overview block visuals — full width, centered on page -->
    {overviewImageSegments.map((seg) => (
      <section class="py-8">
        <div class="container flex flex-col gap-3" style="align-items: center;">
          {seg.visual.type === 'image' ? (
            <div class="w-full bg-gray-100 rounded-xl overflow-hidden" style={seg.visual.fullWidth ? 'margin: 0 auto;' : 'max-width: 860px; margin: 0 auto;'}>
              <img src={seg.visual.src} alt={seg.visual.caption ?? ''} class="w-full block" />
            </div>
          ) : seg.visual.type === 'side-by-side' ? (
            <div class="side-by-side-grid" style="max-width: 860px; margin: 0 auto; width: 100%;">
              <div class="w-full aspect-video bg-gray-100 rounded-xl overflow-hidden">
                <img src={seg.visual.left} alt="" class="w-full h-full object-cover" />
              </div>
              <div class="w-full aspect-video bg-gray-100 rounded-xl overflow-hidden">
                <img src={seg.visual.right} alt="" class="w-full h-full object-cover" />
              </div>
            </div>
          ) : (
            <div class="grid-2x2-grid" style="max-width: 860px; margin: 0 auto; width: 100%;">
              {seg.visual.images.map((src) => (
                <div class="w-full aspect-video bg-gray-100 rounded-xl overflow-hidden">
                  <img src={src} alt="" class="w-full h-full object-cover" />
                </div>
              ))}
            </div>
          )}
          {seg.visual.caption && <p class="rich-caption" style="padding: 0 4px; text-align: center;">{seg.visual.caption}</p>}
          {seg.trailing.length > 0 && (
            <div class="rich-body" style="margin: 24px auto 0;">
              {seg.trailing.map((block) => {
                if (block.type === 'eyebrow') return <p class="rich-eyebrow" set:html={block.html} />;
                if (block.type === 'h2') return <h2 class="rich-h2" set:html={block.html} />;
                if (block.type === 'h3') return <h3 class="rich-h3" set:html={block.html} />;
                if (block.type === 'callout') return (
                  <div class="rich-callout">
                    <p class="rich-callout-title">{block.title}</p>
                    <p class="rich-callout-body" set:html={block.html} />
                  </div>
                );
                return <p class="rich-p" set:html={block.html} />;
              })}
            </div>
          )}
        </div>
      </section>
    ))}

    <!-- Full bleed image -->
    {project.fullBleedImage && (
    <section class="py-8">
      <div class="container flex flex-col gap-4">
        <div class="w-full aspect-video bg-gray-100 rounded-xl overflow-hidden flex items-center justify-center">
          <img
            src={project.fullBleedImage}
            alt={`${project.title} full image`}
            class="w-full h-full object-cover"
            onerror="this.style.display='none'; this.parentElement.style.background='#f3f4f6';"
          />
        </div>
      </div>
    </section>
    )}

    <!-- Process -->
    {(project.process || project.processBlocks?.length) && (
    <section class="section">
      <div class="container grid gap-16" style="grid-template-columns: 1fr 2fr;">
        <div>
          <div class="border-t border-gray-200 pt-4">
            <h2 class="font-medium text-black" style="font-size: 32px; letter-spacing: -1px;">Process</h2>
          </div>
        </div>
        <div class="rich-body">
          {processPreImageBlocks ? processPreImageBlocks.map((block) => {
            if (block.type === 'h2') return <h2 class="rich-h2" set:html={block.html} />;
            if (block.type === 'h3') return <h3 class="rich-h3" set:html={block.html} />;
            return <p class="rich-p" set:html={block.html} />;
          }) : project.process.split('\n\n').map((para) => (
            <p class="font-normal" style="font-size: 24px; letter-spacing: -0.7px; line-height: 1.5; color: rgba(0,0,0,0.659);">
              {para}
            </p>
          ))}
        </div>
      </div>
    </section>
    )}

    <!-- Process block visuals — full width, with trailing text -->
    {processImageSegments.map((seg) => (
      <section class="py-8">
        <div class="container flex flex-col gap-3">
          {seg.visual.type === 'image' ? (
            <div class="w-full bg-gray-100 rounded-xl overflow-hidden">
              <img src={seg.visual.src} alt={seg.visual.caption ?? ''} class="w-full block" />
            </div>
          ) : seg.visual.type === 'side-by-side' ? (
            <div class="side-by-side-grid">
              <div class="w-full aspect-video bg-gray-100 rounded-xl overflow-hidden">
                <img src={seg.visual.left} alt="" class="w-full h-full object-cover" />
              </div>
              <div class="w-full aspect-video bg-gray-100 rounded-xl overflow-hidden">
                <img src={seg.visual.right} alt="" class="w-full h-full object-cover" />
              </div>
            </div>
          ) : (
            <div class="grid-2x2-grid">
              {seg.visual.images.map((src) => (
                <div class="w-full aspect-video bg-gray-100 rounded-xl overflow-hidden">
                  <img src={src} alt="" class="w-full h-full object-cover" />
                </div>
              ))}
            </div>
          )}
          {seg.visual.caption && <p class="rich-caption" style="padding: 0 4px;">{seg.visual.caption}</p>}
          {seg.trailing.length > 0 && (
            <div class="rich-body" style="margin: 24px auto 0;">
              {seg.trailing.map((block) => {
                if (block.type === 'eyebrow') return <p class="rich-eyebrow" set:html={block.html} />;
                if (block.type === 'h2') return <h2 class="rich-h2" set:html={block.html} />;
                if (block.type === 'h3') return <h3 class="rich-h3" set:html={block.html} />;
                if (block.type === 'callout') return (
                  <div class="rich-callout">
                    <p class="rich-callout-title">{block.title}</p>
                    <p class="rich-callout-body" set:html={block.html} />
                  </div>
                );
                return <p class="rich-p" set:html={block.html} />;
              })}
            </div>
          )}
        </div>
      </section>
    ))}

    <!-- Image 1 -->
    {project.images.length > 0 && (
    <section class="py-8">
      <div class="container flex flex-col gap-4">
        {project.images.slice(0, 1).map((src, i) => {
          const isVideo = /\.(mp4|webm|mov)$/i.test(src);
          return (
            <div class="w-full aspect-video bg-gray-100 rounded-xl overflow-hidden flex items-center justify-center">
              {!src ? (
                <span class="img-placeholder">Image placeholder</span>
              ) : isVideo ? (
                <video src={src} class="w-full h-full object-cover" autoplay muted loop playsinline />
              ) : (
                <img src={src} alt={`${project.title} image ${i + 1}`} class="w-full h-full object-cover" onerror="this.style.display='none'; this.parentElement.style.background='#f3f4f6';" />
              )}
            </div>
          );
        })}
      </div>
    </section>
    )}

    <!-- Post-first-image blocks (optional) -->
    {project.postFirstImageBlocks && (
      <section class="section">
        <div class="container rich-body">
          {project.postFirstImageBlocks.map((block) => {
            if (block.type === 'h2') return <h2 class="rich-h2" set:html={block.html} />;
            if (block.type === 'h3') return <h3 class="rich-h3" set:html={block.html} />;
            if (block.type === 'image') return (
              <figure class="rich-figure">
                <img src={block.src} alt={block.caption ?? ''} class="rich-figure-img" />
                {block.caption && <figcaption class="rich-caption">{block.caption}</figcaption>}
              </figure>
            );
            return <p class="rich-p" set:html={block.html} />;
          })}
        </div>
      </section>
    )}

    <!-- Images 2–3 -->
    {project.images.length > 1 && (
    <section class="py-8">
      <div class="container flex flex-col gap-4">
        {project.images.slice(1, 3).map((src, i) => {
          const isVideo = /\.(mp4|webm|mov)$/i.test(src);
          return (
            <div class="w-full aspect-video bg-gray-100 rounded-xl overflow-hidden flex items-center justify-center">
              {!src ? (
                <span class="img-placeholder">Image placeholder</span>
              ) : isVideo ? (
                <video src={src} class="w-full h-full object-cover" autoplay muted loop playsinline />
              ) : (
                <img src={src} alt={`${project.title} image ${i + 2}`} class="w-full h-full object-cover" onerror="this.style.display='none'; this.parentElement.style.background='#f3f4f6';" />
              )}
            </div>
          );
        })}
      </div>
    </section>
    )}

    <!-- Process part 2 -->
    {(project.process2Blocks?.length || project.process2) && (
      <section class="section">
        <div class="container rich-body">
          {project.process2Blocks?.length ? project.process2Blocks.map((block) => {
            if (block.type === 'h2') return <h2 class="rich-h2" set:html={block.html} />;
            if (block.type === 'h3') return <h3 class="rich-h3" set:html={block.html} />;
            if (block.type === 'image') return (
              <figure class="rich-figure">
                <img src={block.src} alt={block.caption ?? ''} class="rich-figure-img" />
                {block.caption && <figcaption class="rich-caption">{block.caption}</figcaption>}
              </figure>
            );
            return <p class="rich-p" set:html={block.html} />;
          }) : (
            <p class="font-normal" style="font-size: 24px; letter-spacing: -0.7px; line-height: 1.5; color: rgba(0,0,0,0.659);">
              {project.process2}
            </p>
          )}
        </div>
      </section>
    )}

    <!-- Images / Videos 4–6 -->
    {project.images.length > 3 && (
    <section class="py-8">
      <div class="container flex flex-col gap-4">
        {project.images.slice(3).map((src, i) => {
          const isVideo = /\.(mp4|webm|mov)$/i.test(src);
          return (
            <div class="w-full aspect-video bg-gray-100 rounded-xl overflow-hidden flex items-center justify-center">
              {!src ? (
                <span class="img-placeholder">Image placeholder</span>
              ) : isVideo ? (
                <video
                  src={src}
                  class="w-full h-full object-cover"
                  autoplay
                  muted
                  loop
                  playsinline
                />
              ) : (
                <img
                  src={src}
                  alt={`${project.title} image ${i + 4}`}
                  class="w-full h-full object-cover"
                  onerror="this.style.display='none'; this.parentElement.style.background='#f3f4f6';"
                />
              )}
            </div>
          );
        })}
      </div>
    </section>
    )}

    <!-- Outcome -->
    {(project.outcome || project.outcomeBlocks?.length) && (
    <section class="section">
      <div class="container grid gap-16" style="grid-template-columns: 1fr 2fr;">
        <div>
          <div class="border-t border-gray-200 pt-4">
            <h2 class="font-medium text-black" style="font-size: 32px; letter-spacing: -1px;">Outcome</h2>
          </div>
        </div>
        <div class="overview-body">
          {project.outcomeBlocks ? project.outcomeBlocks.map((block) => {
            if (block.type === 'h2') return <h2 class="rich-h2" set:html={block.html} />;
            if (block.type === 'h3') return <h3 class="rich-h3" set:html={block.html} />;
            if (block.type === 'image') return (
              <figure class="rich-figure">
                <img src={block.src} alt={block.caption ?? ''} class="rich-figure-img" />
                {block.caption && <figcaption class="rich-caption">{block.caption}</figcaption>}
              </figure>
            );
            return <p class="rich-p" set:html={block.html} />;
          }) : project.outcome.split('\n\n').map((para) => (
            <p class="font-normal" style="font-size: 24px; letter-spacing: -0.7px; line-height: 1.5; color: rgba(0,0,0,0.659);">
              {para}
            </p>
          ))}
        </div>
      </div>
    </section>
    )}

  </main>

  <!-- More Projects -->
  <section class="section bg-white">
    <div class="container">
      <div class="border-t border-gray-200 mb-10"></div>
      <h2 class="font-medium text-black mb-10" style="font-size: 56px; letter-spacing: -2.2px; line-height: 1.2;">More Projects</h2>
      <div class="more-grid">
        {moreProjects.map((p) => (
          <a href={`/work/${p.slug}`} class="more-card">
            <div class="more-img-wrap">
              <img src={p.image} alt={p.title} class="more-img" onerror="this.style.display='none'" />
            </div>
            <div class="more-overlay">
              <p class="more-title">{p.title}</p>
              <p class="more-desc">{p.subtitle}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-8 border-t border-gray-100">
    <div class="container flex justify-between items-center">
      <a href="/" class="z-logo-footer" aria-label="Home">
        <svg viewBox="0 0 20 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 24px; height: 29px;">
          <path d="M0 23.2727V19.7727L11 5.09091H0.0454546V0H19.0455V3.5L8.04545 18.1818H19V23.2727H0Z" fill="black"/>
        </svg>
      </a>
      <nav class="flex gap-7 text-gray-400" style="font-size: 20px;">
        <a href="/#work">Work</a>
        <a href="/#writing">Writing</a>
        <a href="/#about">About</a>
        <a href="/#contact">Contact</a>
      </nav>
    </div>
  </footer>

</Layout>

<style>
  .z-logo {
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .z-logo:hover {
    opacity: 1;
    transform: rotate(-45deg);
  }

  .z-logo-footer {
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .z-logo-footer:hover {
    transform: rotate(-45deg);
  }

  #case-nav {
    opacity: 0;
    pointer-events: none;
    left: 50%;
    transform: translateX(-50%) translateY(-10px);
    width: calc(100% - 64px);
    max-width: 780px;
    top: 20px;
    border-radius: 999px;
    padding: 14px 28px;
    background-color: #0a0a0a;
    border: 1px solid #222222;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .overview-body {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .img-placeholder {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 999px;
    padding: 6px 16px;
  }

  .nda-tag {
    display: inline-block;
    margin-top: 16px;
    padding: 4px 14px;
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 999px;
    color: rgba(255,255,255,0.6);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nda-note {
    border-left: 2px solid #d1d5db;
    padding: 4px 0 4px 24px;
    margin: 0;
    font-style: italic;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.7;
    color: rgba(0,0,0,0.35);
    letter-spacing: -0.3px;
  }

  .rich-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 860px;
  }

  .rich-eyebrow {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
